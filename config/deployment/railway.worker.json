{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "backend/Dockerfile.celery-worker",
    "watchPatterns": [
      "backend/**",
      "config/deployment/railway.worker.json"
    ]
  },
  "deploy": {
    "startCommand": "celery -A app.celery_app worker --loglevel=info --concurrency=${CELERY_CONCURRENCY:-4}",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
